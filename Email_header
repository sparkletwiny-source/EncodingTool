ENCODER_HTML = r'''<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Email Encoding Tool</title><style>''' + BASE_STYLE + r'''</style></head><body><div class="container"><nav class="nav"><a class="active" href="/">Email Encoding Tool</a><a href="/header-replacer">Email Header Replacer</a><button type="button" class="muted" onclick="toggleTheme()">Toggle Theme</button></nav><h1>Email Encoding Tool</h1><div class="grid"><section class="panel"><h2>Input</h2><form id="encoding-form" method="post"><label>Input Sentence</label><textarea name="text" placeholder="Enter text to encode">{{ text }}</textarea><div class="row"><div><label>Character Encoding</label><select name="charset">{% for key,name in charsets.items() %}<option value="{{key}}" {% if charset==key %}selected{% endif %}>{{name}}</option>{% endfor %}</select></div><div><label>Encoding Format</label><select name="method">{% for key,name in methods.items() %}<option value="{{key}}" {% if method==key %}selected{% endif %}>{{name}}</option>{% endfor %}</select></div></div><div class="box"><b>Encoding Selection</b><div class="option"><input type="radio" id="all" name="selection_mode" value="all" {% if selection_mode=='all' %}checked{% endif %}><label for="all">Encode entire sentence</label></div><div class="option"><input type="radio" id="selected" name="selection_mode" value="selected" {% if selection_mode=='selected' %}checked{% endif %}><label for="selected">Encode specific words / characters</label></div><div class="option"><input type="radio" id="random" name="selection_mode" value="random" {% if selection_mode=='random' %}checked{% endif %}><label for="random">Randomly encode matching words / characters</label></div><div id="randomSettings"><label>Random percentage (1–100)</label><input type="number" name="random_percentage" min="1" max="100" value="{{random_percentage}}"><p class="help">Used by random mode.</p></div></div><label>Specific Words / Letters / Characters</label><input type="text" name="selected_items" value="{{selected_items}}" placeholder="Clean,Today,!,@,#"><p class="help">Separate items with commas. If blank in random mode, words are selected automatically.</p><label>Spaces After Each Word</label><input type="number" min="0" name="spaces_after_word" value="{{spaces_after_word}}"><div class="box"><div class="option"><input type="checkbox" id="space_hex" name="space_hex" {% if space_hex %}checked{% endif %}><label for="space_hex">Encode spaces as =20 instead of _</label></div><div class="option"><input type="checkbox" id="single_line" name="single_line" {% if single_line %}checked{% endif %}><label for="single_line">Single-line output</label></div></div><button type="submit">⚡ Encode</button></form></section><section class="panel"><h2>Result</h2><div id="result" class="result">{% if result is not none %}{{result}}{% else %}Your encoded result will appear here.{% endif %}</div><div class="buttons"><button type="button" onclick="copyResult()">Copy Result</button></div><div id="encoding-meta" class="box" {% if result is none %}hidden{% endif %}><b>Encoding:</b> <span id="meta-method">{{method_name}}</span><br><b>Character set:</b> <span id="meta-charset">{{charset_name}}</span><br><b>Selection:</b> <span id="meta-selection">{{selection_mode}}</span><br><b>Output length:</b> <span id="meta-length">{{output_length}}</span></div><div id="encoding-error" class="error" {% if not error %}hidden{% endif %}>{{error or ""}}</div></section></div></div><script>function toggleTheme(){document.body.classList.toggle('light');localStorage.setItem('email-tool-theme',document.body.classList.contains('light')?'light':'dark')}if(localStorage.getItem('email-tool-theme')==='light')document.body.classList.add('light');function copyResult(){const text=document.getElementById('result').innerText;navigator.clipboard?.writeText(text).catch(()=>fallback(text));if(!navigator.clipboard)fallback(text)}function fallback(text){const t=document.createElement('textarea');t.value=text;document.body.appendChild(t);t.select();document.execCommand('copy');t.remove()}document.getElementById('encoding-form').addEventListener('submit',async function(e){e.preventDefault();const form=e.currentTarget,button=form.querySelector('button[type=submit]'),old=button.textContent,errorBox=document.getElementById('encoding-error');button.disabled=true;button.textContent='Encoding...';errorBox.hidden=true;try{const response=await fetch(window.location.pathname,{method:'POST',body:new FormData(form)});if(!response.ok)throw new Error('Server returned '+response.status);const doc=new DOMParser().parseFromString(await response.text(),'text/html');const newResult=doc.getElementById('result');if(!newResult)throw new Error('Result not found');document.getElementById('result').textContent=newResult.textContent;const meta=doc.getElementById('encoding-meta');if(meta){document.getElementById('encoding-meta').hidden=meta.hidden;for(const id of ['meta-method','meta-charset','meta-selection','meta-length']){const src=doc.getElementById(id),dest=document.getElementById(id);if(src&&dest)dest.textContent=src.textContent;}}const newError=doc.getElementById('encoding-error');if(newError&&!newError.hidden&&newError.textContent.trim()){errorBox.textContent=newError.textContent;errorBox.hidden=false;} }catch(err){errorBox.textContent='Encoding failed. Please try again. '+err.message;errorBox.hidden=false;}finally{button.disabled=false;button.textContent=old;}});function updateRandom(){const r=document.querySelector('input[name="selection_mode"]:checked');document.getElementById('randomSettings').style.display=r&&r.value==='random'?'block':'none'}document.querySelectorAll('input[name="selection_mode"]').forEach(x=>x.addEventListener('change',updateRandom));updateRandom();</script></body></html>'''

HEADER_HTML = r'''<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Email Header Replacer</title><style>''' + BASE_STYLE + r'''#output{min-height:500px;white-space:pre;overflow:auto}.note{font-size:12px;color:#9fb2ca;line-height:1.5;margin-top:12px}</style></head><body><div class="container"><nav class="nav"><a href="/">Email Encoding Tool</a><a class="active" href="/header-replacer">Email Header Replacer</a><button type="button" class="muted" onclick="toggleTheme()">Toggle Theme</button></nav><h1>Email Header Replacer</h1><div class="grid"><section class="panel"><h2>Input</h2><div class="field"><label for="subject">Subject</label><select id="subject">{% for item in subject_options %}<option>{{item}}</option>{% endfor %}</select></div><div class="field"><label for="from">From Name</label><select id="from">{% for item in from_options %}<option>{{item}}</option>{% endfor %}</select></div><label for="listid">List ID</label><input id="listid" value="{listid}"><label for="to">To</label><input id="to" value="{to}"><label for="date">Date</label><input id="date" value="{hdt}"><label for="emailInput">Complete EML Content</label><textarea id="emailInput" style="min-height:320px" placeholder="Paste complete raw .eml content here..." spellcheck="false"></textarea><div class="buttons"><button onclick="processEmail()">Process Email</button><button class="muted" onclick="clearAll()">Clear All</button></div><p class="note">Existing Subject, From, List-ID, To and Date headers are updated only when present. Missing headers are not added. Other headers and the message body are preserved.</p></section><section class="panel"><h2>Processed Output</h2><label for="output">Output EML</label><textarea id="output" readonly placeholder="Processed output will appear here..." spellcheck="false"></textarea><div class="buttons"><button onclick="copyOutput()">Copy Output</button><button onclick="downloadEML()">Download EML</button><button onclick="downloadTXT()">Download TXT</button></div><div id="status" class="status" role="status"></div></section></div></div><script>function toggleTheme(){document.body.classList.toggle('light');localStorage.setItem('email-tool-theme',document.body.classList.contains('light')?'light':'dark')}if(localStorage.getItem('email-tool-theme')==='light')document.body.classList.add('light');function normalizeLineEndings(t){return t.replace(/\r\n/g,'\n').replace(/\r/g,'\n')}function splitEmail(raw){const n=normalizeLineEndings(raw);const m=/\n[ \t]*\n/.exec(n);if(m){const i=m.index;return{headers:n.slice(0,i),body:n.slice(i+m[0].length),separator:'\n\n'}}const lines=n.split('\n'),head=[];let found=false,bodyStart=-1;for(let i=0;i<lines.length;i++){const line=lines[i];if(!line.trim()){if(found){bodyStart=i+1;break}continue}if(/^[ \t]/.test(line)&&found){head.push(line);continue}if(/^[!-9;-~]+:/.test(line)){head.push(line);found=true;continue}if(found){bodyStart=i;break}return null}if(!found)return null;return{headers:head.join('\n'),body:bodyStart>=0?lines.slice(bodyStart).join('\n'):'',separator:'\n\n'}}function updateExistingHeader(headers,name,value){const lines=headers.split('\n'),out=[];let updated=false,skip=false;for(const line of lines){if(/^[ \t]/.test(line)&&skip)continue;skip=false;const i=line.indexOf(':');if(i>0&&line.slice(0,i).trim().toLowerCase()===name.toLowerCase()){out.push(line.slice(0,i).trim()+': '+value);updated=true;skip=true;continue}out.push(line)}return{headers:out.join('\n'),updated}}function processEmail(){const raw=document.getElementById('emailInput').value,out=document.getElementById('output'),status=document.getElementById('status');out.value='';status.textContent='';if(!raw.trim()){status.style.color='#fca5a5';status.textContent='Please paste your complete EML content first.';return}const parts=splitEmail(raw);if(!parts){status.style.color='#fca5a5';status.textContent='Could not identify the email headers. Paste the complete raw EML content.';return}let headers=parts.headers;const updated=[];const replacements=[{name:'Subject',value:document.getElementById('subject').value},{name:'From',value:document.getElementById('from').value+' <'+document.getElementById('listid').value+'>'},{name:'List-ID',value:document.getElementById('listid').value},{name:'To',value:document.getElementById('to').value},{name:'Date',value:document.getElementById('date').value}];for(const item of replacements){const r=updateExistingHeader(headers,item.name,item.value);headers=r.headers;if(r.updated)updated.push(item.name)}out.value=headers+parts.separator+parts.body;status.style.color=updated.length?'#86efac':'#fbbf24';status.textContent=updated.length?'Processing complete. Updated existing headers: '+updated.join(', ')+'.':'No matching headers found. Original content was preserved.'}async function copyOutput(){const out=document.getElementById('output'),s=document.getElementById('status');if(!out.value){s.textContent='There is no output to copy.';return}try{await navigator.clipboard.writeText(out.value);s.textContent='Output copied successfully.'}catch(e){out.focus();out.select();const ok=document.execCommand('copy');s.textContent=ok?'Output copied successfully.':'Copy failed; copy manually.'}}function downloadFile(name,content,type){const s=document.getElementById('status');if(!content){s.textContent='There is no output to download.';return}const blob=new Blob([content],{type:type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)}function downloadEML(){downloadFile('processed_email.eml',document.getElementById('output').value,'message/rfc822')}function downloadTXT(){downloadFile('processed_email.txt',document.getElementById('output').value,'text/plain;charset=utf-8')}function clearAll(){document.getElementById('emailInput').value='';document.getElementById('output').value='';document.getElementById('status').textContent='';document.getElementById('subject').value='{rand15}';document.getElementById('from').value='{rand4}';document.getElementById('listid').value='{listid}';document.getElementById('to').value='{to}';document.getElementById('date').value='{hdt}'}</script></body></html>'''

SUBJECT_OPTIONS = ["{sub}"] + [f"{{rand{n}}}" for n in (3,4,5,8,10,15,20,25,30,35,40,45,50,64,100)] + [f"{{math{n}}}" for n in (3,4,5,6,7,8,9,10,15,20,25,30,35,40,45,50,64,100)] + [f"{{int{n}}}" for n in range(1,6)]
FROM_OPTIONS = ["{from}"] + SUBJECT_OPTIONS[1:] + ["{type2}", "{type3}"]


# One-page version: both tools are displayed on the same page, one after another.
def _body_of(template):
    match = re.search(r"<body>(.*?)</body>", template, re.S)
    return match.group(1) if match else ""

_encoder_body = _body_of(ENCODER_HTML)
_header_body = _body_of(HEADER_HTML)
_encoder_body = _encoder_body.replace('<div class="container">', '<div class="container" id="encoding">', 1)
_header_body = _header_body.replace('<div class="container">', '<div class="container" id="header-replacer">', 1)
# The two tools now use same-page anchors instead of navigating away.
for _body in ("_encoder_body", "_header_body"):
    pass
_encoder_body = _encoder_body.replace('href="/"', 'href="#encoding"').replace('href="/header-replacer"', 'href="#header-replacer"')
_header_body = _header_body.replace('href="/"', 'href="#encoding"').replace('href="/header-replacer"', 'href="#header-replacer"')
_header_extra_css = '#output{min-height:500px;white-space:pre;overflow:auto}.note{font-size:12px;color:#9fb2ca;line-height:1.5;margin-top:12px}'
COMBINED_HTML = '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Email Encoding Tool + Email Header Replacer</title><style>' + BASE_STYLE + _header_extra_css + '</style></head><body>' + _encoder_body + _header_body + '</body></html>'

@app.route("/", methods=["GET", "POST"])
def index():
    data = dict(text="", charset="utf-8", method="q", selection_mode="all", selected_items="", spaces_after_word=0, space_hex=False, single_line=True, random_percentage=50, result=None, error=None)
    if request.method == "POST":
        for key in ("text", "charset", "method", "selection_mode", "selected_items"):
            data[key] = request.form.get(key, data[key])
        data["space_hex"] = request.form.get("space_hex") == "on"
        data["single_line"] = request.form.get("single_line") == "on"
        try: data["spaces_after_word"] = max(0, int(request.form.get("spaces_after_word", "0")))
        except (ValueError, TypeError): data["spaces_after_word"] = 0
        try: data["random_percentage"] = max(1, min(100, int(request.form.get("random_percentage", "50"))))
        except (ValueError, TypeError): data["random_percentage"] = 50
        if data["selection_mode"] not in ("all", "selected", "random"): data["selection_mode"] = "all"
        if data["charset"] not in CHARSETS: data["charset"] = "utf-8"
        if data["method"] not in METHODS: data["method"] = "q"
        try:
            processed = add_spaces_after_words(data["text"], data["spaces_after_word"])
            if data["selection_mode"] == "all": result = encode_text(processed, data["charset"], data["method"], data["space_hex"])
            elif data["selection_mode"] == "selected": result = encode_selected_items(processed, data["selected_items"], data["charset"], data["method"], data["space_hex"])
            else: result = encode_random_selected_items(processed, data["selected_items"], data["charset"], data["method"], data["space_hex"], data["random_percentage"])
            if data["single_line"]: result = result.replace("\r", "").replace("\n", "")
            data["result"] = result
        except UnicodeEncodeError: data["error"] = "The selected character encoding cannot represent one or more input characters."
        except LookupError: data["error"] = "The selected character encoding is not supported."
        except Exception as exc: data["error"] = str(exc)
    data.update(charsets=CHARSETS, methods=METHODS, charset_name=CHARSETS.get(data["charset"], data["charset"]), method_name=METHODS.get(data["method"], data["method"]), output_length=len(data["result"]) if data["result"] is not None else 0)
    return render_template_string(COMBINED_HTML, **data, subject_options=SUBJECT_OPTIONS, from_options=FROM_OPTIONS)

@app.route("/header-replacer", methods=["GET"])
def header_replacer():
    # Keep the old URL working, but show the unified single-page interface.
    from flask import redirect
    return redirect("/#header-replacer")

