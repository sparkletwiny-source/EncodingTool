def add_spaces_after_words(text, count):
    return text if count <= 0 else re.sub(r"(\S+)(?=\s|$)", lambda m: m.group(1) + (" " * count), text)

def q_encode_bytes(data, space_hex=False):
    return "".join("=20" if b == 32 and space_hex else "_" if b == 32 else f"={b:02X}" for b in data)

def split_q_encoded_words(encoded, max_length=75):
    end = encoded.find("?Q?")
    if end == -1 or not encoded.endswith("?="): return encoded
    prefix, payload, suffix = encoded[:end+3], encoded[end+3:-2], "?="
    available = max_length - len(prefix) - len(suffix)
    if available <= 0: return encoded
    chunks, current, i = [], "", 0
    while i < len(payload):
        token = payload[i:i+3] if payload[i] == "=" and i+2 < len(payload) and re.fullmatch(r"[0-9A-Fa-f]{2}", payload[i+1:i+3]) else payload[i]
        if len(current) + len(token) > available:
            if current: chunks.append(current)
            current = token
        else: current += token
        i += len(token)
    if current: chunks.append(current)
    return "  ".join(prefix + chunk + suffix for chunk in chunks)

def encode_q(text, charset, space_hex=False, chunked=False):
    encoded = f"=?{charset.upper()}?Q?{q_encode_bytes(text.encode(CODECS[charset]), space_hex)}?="
    return split_q_encoded_words(encoded, 75) if chunked else encoded

def encode_base64(text, charset):
    return f"=?{charset.upper()}?B?{base64.b64encode(text.encode(CODECS[charset])).decode('ascii')}?="

def encode_other(text, charset, method):
    data = text.encode(CODECS[charset])
    if method == "url": return urllib.parse.quote_from_bytes(data, safe="")
    if method == "html": return html.escape(text)
    if method == "hex": return data.hex(" ")
    if method == "unicode": return "".join(f"\\u{ord(c):04X}" for c in text)
    if method == "json": return json.dumps(text, ensure_ascii=True)
    if method == "punycode": return text.encode("punycode").decode("ascii")
    raise ValueError("Unsupported encoding method")

def encode_text(text, charset, method, space_hex):
    if method == "q": return encode_q(text, charset, space_hex)
    if method.endswith("-q-chunked"):
        chunk_charset = method[:-len("-q-chunked")]
        if chunk_charset not in CHARSETS: raise ValueError("Unsupported chunked Q charset")
        return encode_q(text, chunk_charset, space_hex, True)
    if method == "base64": return encode_base64(text, charset)
    return encode_other(text, charset, method)

def encode_selected_items(text, selected_items, charset, method, space_hex):
    items = [x.strip() for x in selected_items.split(",") if x.strip()]
    if not items: return text
    items.sort(key=len, reverse=True)
    return re.sub("|".join(re.escape(x) for x in items), lambda m: encode_text(m.group(0), charset, method, space_hex), text)

def encode_random_selected_items(text, selected_items, charset, method, space_hex, random_percentage=50):
    percentage = max(1, min(int(random_percentage), 100))
    items = [x.strip() for x in selected_items.split(",") if x.strip()]
    if items:
        items.sort(key=len, reverse=True)
        return re.sub("|".join(re.escape(x) for x in items), lambda m: encode_text(m.group(0), charset, method, space_hex) if random.randint(1,100) <= percentage else m.group(0), text)
    return re.sub(r"\b[\w]+\b", lambda m: encode_text(m.group(0), charset, method, space_hex) if len(m.group(0)) > 1 and random.randint(1,100) <= percentage else m.group(0), text)


